{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 3,
  "upgrade": {
    "source": "cdn",
    "interval": "168h",
    "auto": false,
    "notice": false
  },
  "palette": {
    "background":       "#191f2d",
    "backgroundBright": "#e3e6ef",
    "backgroundDim":    "#293249",
    "onBackground":     "#daf0e3",
    "text":             "#ffffff",
    "textDim":          "#999999",
    "accent1":          "#47b474",
    "accent2":          "#47b4a2",
    "accent3":          "#47b4bb",
    "accent4":          "#9297bc",
    "accent5":          "#be7fbd",
    "accent6":          "#f95d5d",
    "accent1Bright":    "#d9f0e3",
    "accent2Bright":    "#d9f0ec",
    "accent3Bright":    "#daf0f1",
    "accent4Bright":    "#9297bc",
    "accent5Bright":    "#f2e5f1",
    "accent6Bright":    "#fddede",
    "accent1Dim":       "#235a39",
    "accent2Dim":       "#235a51",
    "accent3Dim":       "#225a5e",
    "accent4Dim":       "#3f4467",
    "accent5Dim":       "#693568",
    "accent6Dim":       "#a40606"
  },
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "template": "\u256d\u2500",
          "foreground": "p:textDim"
        },
        {
          "type": "shell",
          "style": "diamond",
          "leading_diamond": "\ue0b6",
          "template": "{{ .Name }} ",
          "foreground": "p:text",
          "background": "p:accent1",
          "properties": {
              "mapped_shell_names": {
                "pwsh": "PS"
              }
          }
        },
        {
          "template": "<parentBackground>\ue0b0</> \uf292 ",
          "foreground": "#FFFB38",
          "background": "#ef5350",
          "type": "root",
          "style": "diamond"
        },
        {
          "type": "path",
          "style": "powerline",
          "properties": {
            "folder_icon": " \uf07b ",
            "home_icon": "\ue617 ",
            "style": "mixed"
          },
          "template": " {{ .Path }} ",
          "powerline_symbol": "\ue0b0",
          "foreground": "p:text",
          "background": "p:accent3"
        },
        {
          "properties": {
            "branch_icon": "\ue725 ",
            "fetch_status": true,
            "fetch_upstream_icon": true
          },
          "template": " {{ .HEAD }}{{if .BranchStatus }} {{ .BranchStatus }}{{ end }}{{ if .Working.Changed }} \uf044 {{ .Working.String }}{{ end }}{{ if and (.Working.Changed) (.Staging.Changed) }} |{{ end }}{{ if .Staging.Changed }}<#ef5350> \uf046 {{ .Staging.String }}</>{{ end }} ",
          "powerline_symbol": "\ue0b0",
          "foreground": "p:text",
          "background": "p:accent4",
          "type": "git",
          "style": "powerline"
        },
        {
          "properties": {
            "style": "roundrock",
            "threshold": 0
          },
          "trailing_diamond": "\ue0b4",
          "template": " \ueba2 {{ .FormattedMs }}\u2800",
          "foreground": "p:text",
          "background": "p:accent5",
          "type": "executiontime",
          "style": "diamond"
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "right",
      "segments": [
        {
          "properties": {
            "fetch_package_manager": true,
            "npm_icon": " <#cc3a3a>\ue5fa</> ",
            "yarn_icon": " <#348cba>\ue6a7</>"
          },
          "leading_diamond": "\ue0b6",
          "trailing_diamond": "\ue0b4 ",
          "template": "\ue718 {{ if .PackageManagerIcon }}{{ .PackageManagerIcon }} {{ end }}{{ .Full }}",
          "foreground": "#3C873A",
          "background": "#303030",
          "type": "node",
          "style": "diamond"
        },
        {
          "leading_diamond": "\ue0b6",
          "trailing_diamond": "\ue0b4 ",
          "template": "\ue235 {{ if .Error }}{{ .Error }}{{ else }}{{ if .Venv }}{{ .Venv }} {{ end }}{{ .Full }}{{ end }}",
          "foreground": "#FFE873",
          "background": "#306998",
          "type": "python",
          "style": "diamond"
        },
        {
          "leading_diamond": "\ue0b6",
          "trailing_diamond": "\ue0b4 ",
          "template": "\ue738 {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }}",
          "foreground": "#ffffff",
          "background": "#0e8ac8",
          "type": "java",
          "style": "diamond"
        },
        {
          "leading_diamond": "\ue0b6",
          "trailing_diamond": "\ue0b4 ",
          "template": "\ue77f {{ if .Unsupported }}\uf071{{ else }}{{ .Full }}{{ end }}",
          "foreground": "#0d6da8",
          "background": "#0e0e0e",
          "type": "dotnet",
          "style": "diamond"
        },
        {
          "leading_diamond": "\ue0b6",
          "trailing_diamond": "\ue0b4 ",
          "template": "\ue626 {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }}",
          "foreground": "#06aad5",
          "background": "#ffffff",
          "type": "go",
          "style": "diamond"
        },
        {
          "leading_diamond": "\ue0b6",
          "trailing_diamond": "\ue0b4 ",
          "template": "\ue7a8 {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }}",
          "foreground": "#925837",
          "background": "#f3f0ec",
          "type": "rust",
          "style": "diamond"
        },
        {
          "leading_diamond": " \ue0b6",
          "trailing_diamond": "\ue0b4 ",
          "template": "\ue798 {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }}",
          "foreground": "#055b9c",
          "background": "#e1e8e9",
          "type": "dart",
          "style": "diamond"
        },
        {
          "leading_diamond": " \ue0b6",
          "trailing_diamond": "\ue0b4 ",
          "template": "\ue753 {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }}",
          "foreground": "#ce092f",
          "background": "#ffffff",
          "type": "angular",
          "style": "diamond"
        },
        {
          "leading_diamond": " \ue0b6",
          "trailing_diamond": "\ue0b4 ",
          "template": "α {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }}",
          "foreground": "#de1f84",
          "background": "#ffffff",
          "type": "aurelia",
          "style": "diamond"
        },
        {
          "leading_diamond": " \ue0b6",
          "trailing_diamond": "\ue0b4 ",
          "template": "{{ if .Error }}{{ .Error }}{{ else }}Nx {{ .Full }}{{ end }}",
          "foreground": "#ffffff",
          "background": "#1e293b",
          "type": "nx",
          "style": "diamond"
        },
        {
          "leading_diamond": " \ue0b6",
          "trailing_diamond": "\ue0b4 ",
          "template": "<#ca3c34>\ue624</> {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }}",
          "foreground": "#359a25",
          "background": "#945bb3",
          "type": "julia",
          "style": "diamond"
        },
        {
          "leading_diamond": "\ue0b6",
          "trailing_diamond": "\ue0b4 ",
          "template": "\ue791 {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }}",
          "foreground": "#9c1006",
          "background": "#ffffff",
          "type": "ruby",
          "style": "diamond"
        },
        {
          "leading_diamond": "\ue0b6",
          "trailing_diamond": "\ue0b4 ",
          "template": "\uf104<#f5bf45>\uf0e7</>\uf105 {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }}",
          "foreground": "#5398c2",
          "background": "#ffffff",
          "type": "azfunc",
          "style": "diamond"
        },
        {
          "leading_diamond": "\ue0b6",
          "trailing_diamond": "\ue0b4 ",
          "template": "\ue7ad {{.Profile}}{{if .Region}}@{{.Region}}{{end}}",
          "foreground": "#faa029",
          "background": "#565656",
          "type": "aws",
          "style": "diamond"
        },
        {
          "leading_diamond": "\ue0b6",
          "trailing_diamond": "\ue0b4",
          "template": "\uf308 {{.Context}}{{if .Namespace}} :: {{.Namespace}}{{end}}",
          "foreground": "#ffffff",
          "background": "#316ce4",
          "type": "kubectl",
          "style": "diamond"
        },
        {
          "type": "battery",
          "style": "powerline",
          "template": " {{ if not .Error }}{{ .Icon }}{{ .Percentage }}{{ end }}{{ .Error }}\uf295 ",
          "properties": {
            "charged_icon": "\uf240 ",
            "charging_icon": "\uf1e6 ",
            "discharging_icon": "\ue234 "
          },
          "foreground": "p:text",
          "foreground_templates": [
            "{{if eq \"Charging\" .State.String}}#b8e994{{end}}",
            "{{if eq \"Discharging\" .State.String}}#fff34e{{end}}",
            "{{if eq \"Full\" .State.String}}p:accent1{{end}}"
          ]
        },
        {
          "type": "os",
          "style": "diamond",
          "properties": {
            "linux": "\ue712",
            "macos": "\ue711",
            "windows": "\ue70f"
          },
          "template": " {{ if .WSL }}WSL at {{ end }}{{.Icon}} ",
          "foreground": "p:text"
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "foreground": "p:textDim",
          "style": "plain",
          "template": "\u2570\u2500",
          "type": "text"
        },
        {
          "type": "time",
          "style": "plain",
          "properties": {
            "time_format": "_2 Jan | 15:04:00"
          },
          "template": "[\uf073 {{ .CurrentDate | date .Format }} \uf017 ] ",
          "foreground_templates": ["{{ if gt .Code 0 }}p:accent6Dim{{ end }}"],
          "foreground": "p:textDim"
        },
        {
          "foreground": "#p:text",
          "foreground_templates": ["{{ if gt .Code 0 }}p:accent6{{ end }}"],
          "properties": {
            "always_enabled": true
          },
          "style": "plain",
          "template": "$ ",
          "type": "status"
        }
      ]
    }
  ]
}
