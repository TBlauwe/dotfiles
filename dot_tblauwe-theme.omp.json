{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 3,
  "upgrade": {
    "source": "cdn",
    "interval": "168h",
    "auto": false,
    "notice": false
  },
  "palette": {
    "background":       "#191f2d",
    "backgroundBright": "#e3e6ef",
    "backgroundDim":    "#293249",
    "onBackground":     "#daf0e3",
    "text":             "#ffffff",
    "textDim":          "#999999",
    "accent1":          "#47b474",
    "accent2":          "#47b4a2",
    "accent3":          "#47b4bb",
    "accent4":          "#9297bc",
    "accent5":          "#be7fbd",
    "accent6":          "#f95d5d",
    "accent1Bright":    "#d9f0e3",
    "accent2Bright":    "#d9f0ec",
    "accent3Bright":    "#daf0f1",
    "accent4Bright":    "#9297bc",
    "accent5Bright":    "#f2e5f1",
    "accent6Bright":    "#fddede",
    "accent1Medium":    "#358757",
    "accent2Medium":    "#35877a",
    "accent3Medium":    "#34878d",
    "accent4Medium":    "#696f92",
    "accent5Medium":    "#935a92",
    "accent6Medium":    "#cc3232",
    "accent1Dim":       "#235a39",
    "accent2Dim":       "#235a51",
    "accent3Dim":       "#225a5e",
    "accent4Dim":       "#3f4467",
    "accent5Dim":       "#693568",
    "accent6Dim":       "#a40606"
  },
  "console_title_template": "{{.Folder}}",
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "template": "\u256d\u2500",
          "foreground": "p:textDim"
        },
        {
          "type": "os",
          "style": "diamond",
          "leading_diamond": "\ue0b6",
          "template": "{{ if .WSL }}WSL at {{ end }}{{.Icon}}",
          "foreground": "p:text",
          "background": "p:accent1Medium",
          "properties": {
            "linux": "\ue712",
            "macos": "\ue711",
            "windows": "\ue70f"
          }
        },
        {
          "type": "shell",
          "style": "plain",
          "template": " {{ .Name }} ",
          "foreground": "p:text",
          "background": "p:accent1Medium",
          "properties": {
            "mapped_shell_names": {
              "pwsh": "PS"
            }
          }
        },
        {
          "type": "root",
          "style": "diamond",
          "template": "<parentBackground>\ue0b0</> \uf292 ",
          "foreground": "<parentForeground>",
          "background": "<parentBackground>"
        },
        {
          "type": "session",
          "style": "plain",
          "template": " \uf2c0 {{ .UserName }} ",
          "foreground": "p:text",
          "background": "p:accent2Medium"
        },
        {
          "type": "session",
          "style": "plain",
          "template": "{{ if .SSHSession }} \ueba9 {{ .HostName }}{{ end }} ",
          "foreground": "p:text",
          "background": "p:accent3Medium"
        },
        {
          "type": "git",
          "style": "powerline",
          "properties": {
            "branch_icon": "\ue725 ",
            "fetch_status": true,
            "fetch_upstream_icon": true
          },
          "template": " {{ .HEAD }}{{if .BranchStatus }} {{ .BranchStatus }}{{ end }}{{ if .Working.Changed }} \uf044 {{ .Working.String }}{{ end }}{{ if and (.Working.Changed) (.Staging.Changed) }} |{{ end }}{{ if .Staging.Changed }}<#ef5350> \uf046 {{ .Staging.String }}</>{{ end }} ",
          "foreground": "p:text",
          "background": "p:accent4Medium"
        },
        {
          "properties": {
            "style": "roundrock",
            "threshold": 0
          },
          "trailing_diamond": "\ue0b4",
          "template": " \ueba2 {{ .FormattedMs }}\u2800",
          "foreground": "p:text",
          "background": "p:accent5Medium",
          "type": "executiontime",
          "style": "diamond"
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "right",
      "segments": [
        {
          "type": "sysinfo",
          "style": "plain",
          "foreground": "p:textDim",
          "leading_diamond": "\ue0b2",
          "template": "\ue266 {{ (div ((sub .PhysicalTotalMemory .PhysicalAvailableMemory)|float64) 1073741824.0) }}/{{ (div .PhysicalTotalMemory 1073741824.0) }}GB "
        },
        {
          "type": "time",
          "style": "plain",
          "properties": {
            "time_format": "02/01/06 \uf017 15:04"
          },
          "template": "\uf073 {{ .CurrentDate | date .Format }}",
          "foreground": "p:textDim"
        },
        {
          "type": "battery",
          "style": "powerline",
          "template": " {{ if not .Error }}{{ .Icon }}{{ .Percentage }}{{ end }}{{ .Error }}\uf295 ",
          "properties": {
            "charged_icon": "\uf240 ",
            "charging_icon": "\uf1e6 ",
            "discharging_icon": "\ue234 "
          },
          "foreground": "p:text",
          "foreground_templates": [
            "{{if eq \"Charging\" .State.String}}#b8e994{{end}}",
            "{{if eq \"Discharging\" .State.String}}#fff34e{{end}}",
            "{{if eq \"Full\" .State.String}}p:accent1{{end}}"
          ]
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "foreground": "p:textDim",
          "style": "plain",
          "template": "\u2570\u2500",
          "type": "text"
        },
        {
          "properties": {
            "fetch_package_manager": true,
            "npm_icon": " <#cc3a3a>\ue5fa</> ",
            "yarn_icon": " <#348cba>\ue6a7</>"
          },
          "leading_diamond": "\ue0b6",
          "trailing_diamond": "\ue0b4 ",
          "template": "\ue718 {{ if .PackageManagerIcon }}{{ .PackageManagerIcon }} {{ end }}{{ .Full }}",
          "foreground": "#3C873A",
          "background": "#303030",
          "type": "node",
          "style": "diamond"
        },
        {
          "type": "python",
          "style": "plain",
          "template": "\ue235 {{ if .Error }}{{ .Error }}{{ else }}{{ if .Venv }}{{ .Venv }} {{ end }}{{ .Full }}{{ end }} ",
          "foreground": "p:accent2"
        },
        {
          "type": "java",
          "style": "diamond",
          "template": "\ue738 {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }}",
          "foreground": "p:accent2"
        },
        {
          "type": "dotnet",
          "style": "diamond",
          "template": "\ue77f {{ if .Unsupported }}\uf071{{ else }}{{ .Full }}{{ end }}",
          "foreground": "p:accent2"
        },
        {
          "type": "go",
          "style": "diamond",
          "template": "\ue626 {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }}",
          "foreground": "p:accent2"
        },
        {
          "type": "rust",
          "style": "diamond",
          "template": "\ue7a8 {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }}",
          "foreground": "p:accent2"
        },
        {
          "type": "dart",
          "style": "diamond",
          "template": "\ue798 {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }}",
          "foreground": "p:accent2"
        },
        {
          "type": "angular",
          "style": "diamond",
          "template": "\ue753 {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }}",
          "foreground": "p:accent2"
        },
        {
          "type": "aurelia",
          "style": "diamond",
          "template": "α {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }}",
          "foreground": "p:accent2"
        },
        {
          "type": "nx",
          "style": "diamond",
          "template": "{{ if .Error }}{{ .Error }}{{ else }}Nx {{ .Full }}{{ end }}",
          "foreground": "p:accent2"
        },
        {
          "type": "julia",
          "style": "diamond",
          "template": "<#ca3c34>\ue624</> {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }}",
          "foreground": "p:accent2"
        },
        {
          "type": "ruby",
          "style": "diamond",
          "template": "\ue791 {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }}",
          "foreground": "p:accent2"
        },
        {
          "type": "azfunc",
          "style": "diamond",
          "template": "\uf104<#f5bf45>\uf0e7</>\uf105 {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }}",
          "foreground": "p:accent2"
        },
        {
          "type": "aws",
          "style": "diamond",
          "template": "\ue7ad {{.Profile}}{{if .Region}}@{{.Region}}{{end}}",
          "foreground": "p:accent2"
        },
        {
          "type": "kubectl",
          "style": "diamond",
          "template": "\uf308 {{.Context}}{{if .Namespace}} :: {{.Namespace}}{{end}}",
          "foreground": "p:accent2"
        },
        {
          "type": "path",
          "style": "plain",
          "properties": {
            "style": "agnoster_short",
            "folder_separator_icon": "/",
            "max_depth": 2
          },
          "template": "\uf115  {{ .Path }} ",
          "foreground": "p:accent3"
        },
        {
          "alias": "ShellSymbol",
          "type": "status",
          "style": "plain",
          "foreground": "p:textDim",
          "foreground_templates": ["{{ if gt .Code 0 }}p:accent6{{ end }}"],
          "properties": {
            "always_enabled": true
          },
          "template": "\uf105 "

        }
      ]
    }
  ],
  "transient_prompt": {
    "foreground": "p:textDim",
    "template": "{{ now | date \"15:04\" }} <p:accent2>{{ .UserName }}</>@<p:accent3>{{ .HostName }}</> <p:accent4>{{ .PWD }}</> \uf105 "
  }
}
